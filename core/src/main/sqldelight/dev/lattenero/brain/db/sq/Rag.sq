-- TYPING-ONLY declarations (see Memories.sq): runtime DDL is Migrator's.
-- embedding stands in as TEXT; content_tsv as nullable TEXT (generated column).
CREATE TABLE documents (
  id BIGINT PRIMARY KEY,
  source TEXT NOT NULL,
  uri TEXT NOT NULL,
  title TEXT NOT NULL,
  content TEXT NOT NULL,
  content_sha TEXT NOT NULL,
  meta TEXT NOT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE TABLE chunks (
  id BIGINT PRIMARY KEY,
  doc_id BIGINT NOT NULL,
  ordinal INTEGER NOT NULL,
  heading TEXT NOT NULL DEFAULT '',
  content TEXT NOT NULL,
  content_tsv TEXT,
  embed_model TEXT NOT NULL,
  embedding TEXT NOT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

countDocuments:
SELECT count(*) AS n FROM documents;

countChunks:
SELECT count(*) AS n FROM chunks;

documentsBySource:
SELECT source, count(*) AS n FROM documents GROUP BY source ORDER BY source;
