-- TYPING-ONLY declarations (see Memories.sq): runtime DDL is Migrator's.
-- embedding stands in as TEXT; content_tsv as nullable TEXT (generated column).
CREATE TABLE documents (
  id BIGINT PRIMARY KEY,
  source TEXT NOT NULL,
  uri TEXT NOT NULL,
  title TEXT NOT NULL,
  content TEXT NOT NULL,
  content_sha TEXT NOT NULL,
  meta TEXT NOT NULL DEFAULT '{}',
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE TABLE chunks (
  id BIGINT PRIMARY KEY,
  doc_id BIGINT NOT NULL,
  ordinal INTEGER NOT NULL,
  heading TEXT NOT NULL DEFAULT '',
  content TEXT NOT NULL,
  content_tsv TEXT,
  embed_model TEXT NOT NULL,
  embedding TEXT NOT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

countDocuments:
SELECT count(*) AS n FROM documents;

countChunks:
SELECT count(*) AS n FROM chunks;

documentsBySource:
SELECT source, count(*) AS n FROM documents GROUP BY source ORDER BY source;

-- M2 writes.
existingDoc:
SELECT id, content_sha FROM documents WHERE uri = :uri;

upsertDocument:
INSERT INTO documents (source, uri, title, content, content_sha)
VALUES (:source, :uri, :title, :content, :sha)
ON CONFLICT (uri) DO UPDATE SET source = EXCLUDED.source, title = EXCLUDED.title,
  content = EXCLUDED.content, content_sha = EXCLUDED.content_sha, updated_at = now()
RETURNING id;

deleteChunksByDoc:
DELETE FROM chunks WHERE doc_id = :docId;

deleteDocument:
DELETE FROM documents WHERE id = :docId RETURNING id;

insertChunk:
INSERT INTO chunks (doc_id, ordinal, heading, content, embed_model, embedding)
VALUES (:docId, :ordinal, :heading, :content, :embedModel, :embedding::vector);

deleteDocumentsNotIn:
DELETE FROM documents WHERE source = :source
  AND uri NOT IN (SELECT unnest(:keptUris::text[]));

-- The citations hybrid (RagStore.SEARCH): two ranked legs, one fused list.
-- The vector leg is an exact scan (the 1-row params CTE hides the constant
-- from the HNSW planner); exact beats approximate until the corpus outgrows it.
-- `sim` carries the vector cosine similarity (1 - dist) out of the leg — the
-- relevance signal RRF cannot express (rank-based scores saturate at ~0.03
-- for noise and hits alike, measured 22/11); NULL for FTS-only hits.
-- The lighthouse (plan v2.0 U1, measured 26/11): the curated notes trees
-- (`*-kb/notes/`, [Curated]) outrank the manuals they curate — one extra
-- first-place vote (1/61, [Rrf.CURATED_VOTE]); without it the mirrors won
-- 16 of 45 English concept questions.
searchRag:
WITH params AS (
  SELECT :qv::vector AS qv, :model::text AS model, :n::int AS n, websearch_to_tsquery('simple', :text) AS tsq
), vec AS (
  SELECT id, dist, row_number() OVER (ORDER BY dist, id) AS r FROM (
    SELECT c.id, c.embedding <=> p.qv AS dist
    FROM chunks c, params p WHERE c.embed_model = p.model
    ORDER BY dist, c.id LIMIT (SELECT n FROM params)
  ) top
), fts AS (
  SELECT id, row_number() OVER (ORDER BY rank DESC, id) AS r FROM (
    SELECT c.id, ts_rank_cd(c.content_tsv, p.tsq) AS rank
    FROM chunks c, params p
    WHERE c.embed_model = p.model AND c.content_tsv @@ p.tsq
    ORDER BY rank DESC, c.id LIMIT (SELECT n FROM params)
  ) top
), fused AS (
  SELECT l.id,
         SUM(1.0 / (60 + l.r))
           + CASE WHEN d.uri LIKE '%-kb/notes/%' THEN 1.0 / 61 ELSE 0.0 END AS score
  FROM (SELECT id, r FROM vec UNION ALL SELECT id, r FROM fts) l
  JOIN chunks ck ON ck.id = l.id
  JOIN documents d ON d.id = ck.doc_id
  GROUP BY l.id, d.uri
)
SELECT c.id, c.doc_id, d.uri, d.title, c.heading, c.ordinal, c.content, f.score,
       vec.r AS vec_rank,
       fts.r AS fts_rank,
       1 - vec.dist AS sim
FROM fused f
JOIN chunks c ON c.id = f.id
JOIN documents d ON d.id = c.doc_id
LEFT JOIN vec ON vec.id = c.id
LEFT JOIN fts ON fts.id = c.id
ORDER BY f.score DESC, c.id
LIMIT :k;

-- The usage eval's re-materialization: the content a logged query was served,
-- by chunk id (chunks pruned since the query simply don't come back — the
-- logged top_uris remain the query's history).
chunksByIds:
SELECT c.id, d.uri, c.content
FROM chunks c JOIN documents d ON d.id = c.doc_id
WHERE c.id IN (SELECT unnest(:ids::bigint[]))
ORDER BY c.id;
