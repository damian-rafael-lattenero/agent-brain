<configuration>
  <!-- Logs go to stderr: stdout is reserved for the CLI's JSON. -->
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <!--
        One event, one line: any CR/LF inside the message is collapsed. A log
        message is not always ours — the MCP SDK logs the client-supplied tool
        name verbatim ("Tool not found: …"), so a caller could otherwise forge
        whole lines, including a fake "rejected … without a valid token". The
        throwable's stack trace stays multi-line on purpose (%ex is not touched);
        its messages are ours, not the caller's. Pinned by LogLinePolicyTest.
      -->
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} - %replace(%msg){'[\r\n]+', ' '}%n</pattern>
    </encoder>
  </appender>
  <logger name="com.zaxxer.hikari" level="WARN"/>
  <logger name="io.ktor" level="INFO"/>
  <root level="INFO">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
