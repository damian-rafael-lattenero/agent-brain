<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- com.zcode.lora-resume — the data-pass training as a SELF-HEALING launchd
     job: KeepAlive SuccessfulExit=false means launchd RELAUNCHES it on crash
     (resuming from the newest checkpoint via --resume-adapter-file) and
     leaves it alone when it completes cleanly (exit 0 at iter 800). A crash
     is retried, a completion is terminal — the respawn-loop law respected:
     failure-driven, with a terminal condition.
     Install:
       sed "s|__HOME__|$HOME|g" scripts/com.zcode.lora-resume.plist > ~/Library/LaunchAgents/com.zcode.lora-resume.plist
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.zcode.lora-resume.plist -->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>com.zcode.lora-resume</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/Projects/agent-brain/evals/lora/venv/bin/mlx_lm.lora</string>
		<string>--train</string>
		<string>--model</string>
		<string>__HOME__/Projects/agent-brain/evals/lora/base-model</string>
		<string>--data</string>
		<string>/Users/lattenero/Projects/agent-brain/evals/lora/full-run</string>
		<string>--fine-tune-type</string>
		<string>lora</string>
		<string>--batch-size</string>
		<string>1</string>
		<string>--iters</string>
		<string>800</string>
		<string>--learning-rate</string>
		<string>1e-4</string>
		<string>--num-layers</string>
		<string>16</string>
		<string>--mask-prompt</string>
		<string>--max-seq-length</string>
		<string>1536</string>
		<string>--steps-per-eval</string>
		<string>400</string>
		<string>--steps-per-report</string>
		<string>100</string>
		<string>--save-every</string>
		<string>400</string>
		<string>--adapter-path</string>
		<string>__HOME__/Projects/agent-brain/evals/lora/adapter-data-pass</string>
		<string>--resume-adapter-file</string>
		<string>__HOME__/Projects/agent-brain/evals/lora/adapter-data-pass/adapters.safetensors</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/lora-resume.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/lora-resume.log</string>
	<key>WorkingDirectory</key>
	<string>__HOME__/Projects/agent-brain</string>
</dict>
</plist>
