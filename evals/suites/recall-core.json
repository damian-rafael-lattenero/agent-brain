{
  "name": "recall-core",
  "kind": "recall",
  "gate": 0.9,
  "description": "The cheap CI gate: 20 questions (10 literal, 10 paraphrased) over the shipped fixture corpus; a case passes when the expected document shows up in the top 5 hybrid hits. 'needles' is informational: they check that the top hit really supports the answer (the honest citation assertion while generation lives in the caller).",
  "cases": [
    {
      "type": "recall",
      "id": "migrator-lock-literal",
      "question": "which advisory lock id does the migration runner take?",
      "uri": "/migrator-lock.md",
      "needles": ["727001"]
    },
    {
      "type": "recall",
      "id": "embedding-dimensions-literal",
      "question": "how many dimensions does nomic-embed-text produce?",
      "uri": "/embedding-dimensions.md",
      "needles": ["768"]
    },
    {
      "type": "recall",
      "id": "bus-contract-literal",
      "question": "what are the seven fields of a bus event?",
      "uri": "/bus-contract.md",
      "needles": ["payload", "seven"]
    },
    {
      "type": "recall",
      "id": "hybrid-retrieval-literal",
      "question": "how are the vector and full-text rank lists combined?",
      "uri": "/hybrid-retrieval.md",
      "needles": ["rank fusion", "rrf", "60"]
    },
    {
      "type": "recall",
      "id": "message-storm-literal",
      "question": "what caused the bot to send 118 messages at 12:33?",
      "uri": "/message-storm.md",
      "needles": ["118"]
    },
    {
      "type": "recall",
      "id": "jdk-policy-literal",
      "question": "which JDK distribution is installed through Homebrew casks?",
      "uri": "/jdk-policy.md",
      "needles": ["corretto"]
    },
    {
      "type": "recall",
      "id": "tailer-truncation-literal",
      "question": "what does the tailer do when the bus file is shorter than the saved offset?",
      "uri": "/tailer-truncation.md",
      "needles": ["byte zero", "byte 0", "zero"]
    },
    {
      "type": "recall",
      "id": "kap-timeout-retry-literal",
      "question": "why is a KAP timeout placed before retry never retried?",
      "uri": "/kap-timeout-retry.md",
      "needles": ["timeoutcancellationexception", "cancellation"]
    },
    {
      "type": "recall",
      "id": "circuit-breaker-literal",
      "question": "after how many consecutive failures does the embedding circuit breaker open?",
      "uri": "/circuit-breaker.md",
      "needles": ["five", "5"]
    },
    {
      "type": "recall",
      "id": "telegram-black-box-literal",
      "question": "how does tier five talk to the real Telegram account?",
      "uri": "/telegram-black-box.md",
      "needles": ["mtproto"]
    },
    {
      "type": "recall",
      "id": "tailer-dedupe-paraphrase",
      "question": "what does the database do with an event id it already has?",
      "uri": "/tailer-truncation.md",
      "needles": ["deduplicat"]
    },
    {
      "type": "recall",
      "id": "hybrid-citations-paraphrase",
      "question": "where do the citations of a retrieval hit point?",
      "uri": "/hybrid-retrieval.md",
      "needles": ["uri", "ordinal"]
    },
    {
      "type": "recall",
      "id": "kap-slow-embedding-paraphrase",
      "question": "what broke the retry of a slow embedding call?",
      "uri": "/kap-timeout-retry.md",
      "needles": ["timeout", "cancellation"]
    },
    {
      "type": "recall",
      "id": "jdk-casks-paraphrase",
      "question": "which brew casks install the JDKs?",
      "uri": "/jdk-policy.md",
      "needles": ["corretto"]
    },
    {
      "type": "recall",
      "id": "bus-rotated-file-paraphrase",
      "question": "what happens to a poisoned or rotated bus file?",
      "uri": "/tailer-truncation.md",
      "needles": ["byte zero", "shrink", "rotated"]
    },
    {
      "type": "recall",
      "id": "message-storm-postmortem-paraphrase",
      "question": "what did the postmortem of the message storm fix?",
      "uri": "/message-storm.md",
      "needles": ["golden test", "key"]
    },
    {
      "type": "recall",
      "id": "embedding-model-schema-paraphrase",
      "question": "which model answers the extraction under a schema?",
      "uri": "/embedding-dimensions.md"
    },
    {
      "type": "recall",
      "id": "telegram-readback-paraphrase",
      "question": "how does the black-box driver read the chat back?",
      "uri": "/telegram-black-box.md",
      "needles": ["telethon", "reads the chat back"]
    },
    {
      "type": "recall",
      "id": "migrator-race-paraphrase",
      "question": "what serializes two migrators racing?",
      "uri": "/migrator-lock.md",
      "needles": ["advisory lock", "pg_advisory_lock"]
    },
    {
      "type": "recall",
      "id": "circuit-breaker-open-paraphrase",
      "question": "when does the breaker fail fast?",
      "uri": "/circuit-breaker.md",
      "needles": ["while open", "opens after five", "five"]
    }
  ]
}
